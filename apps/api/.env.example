# Required environment variables for the ChatWar API
# Copy this file to .env (used by Prisma & the API at runtime)
# Use .env.local for personal overrides (never committed)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://www.chatwar.ai,https://chatwar.ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatwar
